DATABASE_URL=sqlite:///./ct200.db
GENERATION_STORE=json # json | mongo
JSON_STORE_PATH=./generations.json
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ct200
LLM_PROVIDER=mock # mock | groq | gemini | openrouter
LLM_API_KEY=
LLM_BASE_URL= # e.g. https://api.groq.com/openai/v1 or https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL= # check provider's current free-tier model list e.g. llama-3.3-70b-versatile or gemini-2.0-flash
LLM_TIMEOUT_S=60
LLM_MAX_REPAIR_ATTEMPTS=2
